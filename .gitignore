# Xcode & macOS
.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcarchive

# Output
Payload/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Python
__pycache__/
*.pyc

# 个人数据：背包原始快照、采集库、行情缓存都由脚本生成，不进仓库。
data/

# 真实背包快照含白金/星币余额和每件 Prime 部件的持有数，等同账号信息。
# 仓库公开，所以只提交脱敏过的 InventoryData.sample.json，CI 打包时把样例
# 复制成这个名字；真数据在手机上由 App 从 VPS 拉。
WarframeWatch/Resources/InventoryData.json

# 仲裁排程是公开数据，但每天在变：构建时现抓，仓库里只留一个空的占位。
# App 优先用 VPS 上那份，包里这份只在断网启动时兜底。
WarframeWatch/Resources/ArbSchedule.json

# 工作区记忆与临时文件
.workbuddy/

# 本机凭据（VPS 密码、发布 token），只在跑监听脚本的那台机器上
.env.local

# 计算器数据产物：由 scripts/build_dpsapp.py 生成，含本机配卡，不进仓库
server/data/payload.json
node_modules/

# 计算器前端离线包：由 scripts/build_web_site.py 从 server/site 生成
# （站点脚本 + 666 把武器 + 敌人 + 中文表 + 预生成索引），不重复提交 4MB 数据
web/app/site/
# iOS 侧是同一份资源的复制，作为 folder reference 打进 App 包
ios/DamageCalc/
